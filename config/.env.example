# =====================================================================
# 电商货源 AI 选品 Agent · 环境变量模板
# 使用方法：
#   1) 复制本文件为 config/.env（同目录）： copy config\.env.example config\.env
#   2) 把下面的占位值替换成你自己的真实凭证
#   3) config/.env 已被 .gitignore 排除，永远不会被提交到 Git
# 说明：程序启动时由 src/settings.py::load_env()（python-dotenv）读取本文件，
#       系统环境变量已存在的同名键不会被覆盖。
# =====================================================================

# ---- 通义千问 / 百炼 DashScope（AI 选品 + Function-Call Agent 必填）----
# 申请地址：https://bailian.console.aliyun.com/
DASHSCOPE_API_KEY=sk-请替换为你的DashScope-API-KEY

# 百炼业务空间 ID（可选）：使用默认业务空间时留空即可
DASHSCOPE_WORKSPACE_ID=

# ---- MySQL 数据库（采集备份表 / 业务表 / 选品结果表 必填）----
DB_HOST=127.0.0.1
DB_PORT=3306
DB_USER=你的数据库账号
DB_PASSWORD=你的数据库密码
DB_NAME=spider_db

# ---- 目标站点登录态（可选：不填则以匿名会话运行，详情页数据会降级）----
# 导出方式见 src/collector/session_login.py 模块注释
QCC_LOGIN_USER=
QCC_AUTH_TOKEN=
QCC_LOGIN_COOKIE=
# 可选：自定义 UA，留空使用代码内默认 UA
QCC_USER_AGENT=
